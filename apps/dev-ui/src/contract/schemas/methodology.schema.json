  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "$ref": "#/$defs/ConfidenceMethodology"
    },
    "contract_status": {
      "const": "internal",
      "description": "INTERNAL / non-binding engineering contract; not the public contract.",
