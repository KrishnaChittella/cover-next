    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricView"
      },
      "title": "Metrics",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_note": {
      "title": "Scope Note",
      "type": "string"
    },
    "score": {
      "$ref": "#/$defs/ScoreMethodology"
    },
    "score_version": {
      "title": "Score Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceMethodology"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "contract_status",
    "generated_at",
    "run_id",
    "score_version",
    "scope_note",
    "score",
    "confidence",
    "event_heat",
    "features",
    "explanations",
    "metrics",
    "sources",
    "limitations"
  ],
