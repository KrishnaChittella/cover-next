{
  "$defs": {
    "ManifestPaths": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "title": "Current",
          "type": "string"
        },
        "games": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Games",
          "type": "object"
        },
        "methodology": {
          "title": "Methodology",
          "type": "string"
        },
        "radar": {
          "title": "Radar",
          "type": "string"
        },
        "source_health": {
          "title": "Source Health",
          "type": "string"
        },
        "validation": {
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "current",
        "source_health",
        "methodology",
        "radar",
        "validation",
        "games"
      ],
      "title": "ManifestPaths",
      "type": "object"
    },
    "RestrictedSourceView": {
      "additionalProperties": false,
      "description": "A source whose data is in this bundle and is not cleared to be shown publicly.",
      "properties": {
        "cleared_stages": {
          "items": {
            "type": "string"
          },
          "title": "Cleared Stages",
          "type": "array"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "purpose",
        "cleared_stages",
        "reason"
      ],
      "title": "RestrictedSourceView",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/ManifestPaths"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "contract_status": {
      "const": "internal",
      "description": "INTERNAL / non-binding engineering contract; not the public contract.",
      "title": "Contract Status",
      "type": "string"
    },
    "distribution": {
      "enum": [
        "internal",
        "private_development_only"
      ],
      "title": "Distribution",
      "type": "string"
    },
    "game_count": {
      "minimum": 0,
      "title": "Game Count",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "ranked_count": {
      "minimum": 0,
      "title": "Ranked Count",
      "type": "integer"
    },
    "restricted_sources": {
      "items": {
        "$ref": "#/$defs/RestrictedSourceView"
      },
      "title": "Restricted Sources",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "score_version": {
      "title": "Score Version",
      "type": "string"
    },
    "version_path": {
      "title": "Version Path",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_status",
    "generated_at",
    "run_id",
    "score_version",
    "distribution",
    "restricted_sources",
    "content_hash",
    "version_path",
    "artifacts",
    "game_count",
    "ranked_count"
  ],
  "title": "Manifest",
  "type": "object"
}
