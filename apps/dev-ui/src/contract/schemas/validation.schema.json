        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "outcome_availability": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Outcome Availability",
          "type": "string"
        },
        "persistence_7d": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persistence 7D"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "realized_uplift_72h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realized Uplift 72H"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "slug": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
