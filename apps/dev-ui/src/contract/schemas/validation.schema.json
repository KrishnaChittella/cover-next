  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Historical validation, or the plain statement that none has been run.\n\n\"not_run\" carries no report and no number. It is not a result of zero.",
  "properties": {
    "availability": {
      "enum": [
        "available",
        "not_run"
      ],
      "title": "Availability",
      "type": "string"
    },
    "contract_status": {
      "const": "internal",
      "description": "INTERNAL / non-binding engineering contract; not the public contract.",
      "title": "Contract Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "outcome_definition": {
      "$ref": "#/$defs/OutcomeDefinitionView"
    },
    "protocol_version": {
      "title": "Protocol Version",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationReportView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_note": {
      "title": "Scope Note",
      "type": "string"
    },
    "score_version": {
      "title": "Score Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_status",
    "generated_at",
    "run_id",
    "score_version",
