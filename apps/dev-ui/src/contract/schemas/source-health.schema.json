{
  "$defs": {
    "EventSourceGameView": {
      "additionalProperties": false,
      "properties": {
        "candidates_classified": {
          "minimum": 0,
          "title": "Candidates Classified",
          "type": "integer"
        },
        "candidates_not_promoted": {
          "minimum": 0,
          "title": "Candidates Not Promoted",
          "type": "integer"
        },
        "candidates_promoted": {
          "minimum": 0,
          "title": "Candidates Promoted",
          "type": "integer"
        },
        "canonical_game_id": {
          "title": "Canonical Game Id",
          "type": "string"
        },
        "fetches_failed": {
          "minimum": 0,
          "title": "Fetches Failed",
          "type": "integer"
        },
        "fetches_ok": {
          "minimum": 0,
          "title": "Fetches Ok",
          "type": "integer"
        },
        "last_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Checked At"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "posts": {
          "minimum": 0,
          "title": "Posts",
          "type": "integer"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "source_game_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Game Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_game_id",
        "slug",
        "name",
        "source_game_ids",
        "fetches_ok",
        "fetches_failed",
        "posts",
        "candidates_classified",
        "candidates_promoted",
        "candidates_not_promoted"
      ],
      "title": "EventSourceGameView",
      "type": "object"
    },
    "EventSourceStageView": {
      "additionalProperties": false,
      "properties": {
        "cleared": {
          "title": "Cleared",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "cleared",
        "reason"
      ],
      "title": "EventSourceStageView",
      "type": "object"
    },
    "EventSourceView": {
      "additionalProperties": false,
      "description": "An event source: what it was asked by `as_of` and what came of it, in counts.\n\nA post is not an event. `posts_observed` and `candidates` count announcements;\nonly `candidates_promoted` became event observations, and only those can reach\nEvent Heat or the radar. No title or text of a post is published here.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "candidates": {
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "candidates_classified": {
          "minimum": 0,
          "title": "Candidates Classified",
          "type": "integer"
        },
        "candidates_not_promoted": {
          "minimum": 0,
          "title": "Candidates Not Promoted",
          "type": "integer"
        },
        "candidates_promoted": {
          "minimum": 0,
          "title": "Candidates Promoted",
          "type": "integer"
        },
        "candidates_unresolved": {
          "minimum": 0,
          "title": "Candidates Unresolved",
          "type": "integer"
        },
        "classification_rules_version": {
          "title": "Classification Rules Version",
          "type": "string"
        },
        "fetches_after_as_of": {
          "minimum": 0,
          "title": "Fetches After As Of",
          "type": "integer"
        },
        "fetches_failed": {
          "minimum": 0,
          "title": "Fetches Failed",
          "type": "integer"
        },
        "fetches_not_sent": {
          "minimum": 0,
          "title": "Fetches Not Sent",
          "type": "integer"
        },
        "fetches_ok": {
          "minimum": 0,
          "title": "Fetches Ok",
          "type": "integer"
        },
        "games": {
          "items": {
            "$ref": "#/$defs/EventSourceGameView"
          },
          "title": "Games",
          "type": "array"
        },
        "games_checked": {
          "minimum": 0,
          "title": "Games Checked",
          "type": "integer"
        },
        "last_failure_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Failure At"
        },
        "last_success_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success At"
        },
        "posts_observed": {
          "minimum": 0,
          "title": "Posts Observed",
          "type": "integer"
        },
        "promoted_event_types": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Promoted Event Types",
          "type": "object"
        },
        "purpose": {
          "const": "event_intelligence",
          "title": "Purpose",
          "type": "string"
        },
        "refusals": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Refusals",
          "type": "object"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "stage_clearance": {
          "items": {
            "$ref": "#/$defs/EventSourceStageView"
          },
          "title": "Stage Clearance",
          "type": "array"
        },
        "status": {
          "enum": [
            "not_collected",
            "collected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source",
        "purpose",
        "classification_rules_version",
        "as_of",
        "status",
        "stage_clearance",
        "fetches_ok",
        "fetches_failed",
        "fetches_not_sent",
        "games_checked",
        "posts_observed",
        "candidates",
        "candidates_classified",
        "candidates_promoted",
        "candidates_not_promoted",
        "candidates_unresolved",
        "refusals",
        "promoted_event_types",
        "fetches_after_as_of",
        "games"
      ],
      "title": "EventSourceView",
      "type": "object"
    },
    "SourceFailure": {
      "additionalProperties": false,
      "properties": {
        "canonical_game_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Canonical Game Id",
          "type": "string"
        },
        "error_code": {
          "title": "Error Code",
          "type": "string"
        },
        "slug": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "canonical_game_id",
        "slug",
        "error_code"
      ],
      "title": "SourceFailure",
      "type": "object"
    },
    "SourceFreshness": {
      "additionalProperties": false,
      "properties": {
        "expected_latest_day": {
          "format": "date",
          "title": "Expected Latest Day",
          "type": "string"
        },
        "latest_observed_day": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Observed Day"
        },
        "staleness_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staleness Days"
        }
      },
      "required": [
        "expected_latest_day"
      ],
      "title": "SourceFreshness",
      "type": "object"
    },
    "SourceHealthEntry": {
      "additionalProperties": false,
      "properties": {
        "entities_attempted": {
          "minimum": 0,
          "title": "Entities Attempted",
          "type": "integer"
        },
        "entities_failed": {
          "minimum": 0,
          "title": "Entities Failed",
          "type": "integer"
        },
        "entities_not_mapped": {
          "minimum": 0,
          "title": "Entities Not Mapped",
          "type": "integer"
        },
        "entities_succeeded": {
          "minimum": 0,
          "title": "Entities Succeeded",
          "type": "integer"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/SourceFailure"
          },
          "title": "Failures",
          "type": "array"
        },
        "freshness": {
          "$ref": "#/$defs/SourceFreshness"
        },
        "last_success": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source",
        "status",
        "freshness",
        "entities_attempted",
        "entities_succeeded",
        "entities_failed",
        "entities_not_mapped",
        "failures"
      ],
      "title": "SourceHealthEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_status": {
      "const": "internal",
      "description": "INTERNAL / non-binding engineering contract; not the public contract.",
      "title": "Contract Status",
      "type": "string"
    },
    "event_sources": {
      "items": {
        "$ref": "#/$defs/EventSourceView"
      },
      "title": "Event Sources",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "score_version": {
      "title": "Score Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceHealthEntry"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "contract_status",
    "generated_at",
    "run_id",
    "score_version",
    "sources",
    "event_sources"
  ],
  "title": "SourceHealthArtifact",
  "type": "object"
}
