{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "not_required",
        "pending",
        "approved",
        "denied"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "ConfidenceMethodology": {
      "additionalProperties": false,
      "properties": {
        "bands": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Bands",
          "type": "object"
        },
        "current_ceiling": {
          "title": "Current Ceiling",
          "type": "number"
        },
        "range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Range",
          "type": "array"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/TermDefinition"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "range",
        "current_ceiling",
        "bands",
        "terms"
      ],
      "title": "ConfidenceMethodology",
      "type": "object"
    },
    "FeatureDefinition": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "valid_when": {
          "title": "Valid When",
          "type": "string"
        }
      },
      "required": [
        "name",
        "unit",
        "definition",
        "valid_when"
      ],
      "title": "FeatureDefinition",
      "type": "object"
    },
    "FeatureMethodology": {
      "additionalProperties": false,
      "properties": {
        "definitions": {
          "items": {
            "$ref": "#/$defs/FeatureDefinition"
          },
          "title": "Definitions",
          "type": "array"
        },
        "granularity": {
          "title": "Granularity",
          "type": "string"
        },
        "history_days": {
          "title": "History Days",
          "type": "integer"
        },
        "principle": {
          "title": "Principle",
          "type": "string"
        }
      },
      "required": [
        "granularity",
        "history_days",
        "principle",
        "definitions"
      ],
      "title": "FeatureMethodology",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "daily_pageviews"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Permission": {
      "enum": [
        "allowed",
        "restricted",
        "prohibited",
        "unknown"
      ],
      "title": "Permission",
      "type": "string"
    },
    "Requirement": {
      "enum": [
        "required",
        "not_required",
        "unknown"
      ],
      "title": "Requirement",
      "type": "string"
    },
    "ScoreMethodology": {
      "additionalProperties": false,
      "properties": {
        "range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Range",
          "type": "array"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/TermDefinition"
          },
          "title": "Terms",
          "type": "array"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "range",
        "terms"
      ],
      "title": "ScoreMethodology",
      "type": "object"
    },
    "SourceMethodology": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "granularity": {
          "title": "Granularity",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "policy": {
          "$ref": "#/$defs/SourcePolicy"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "metric",
        "granularity",
        "description",
        "policy"
      ],
      "title": "SourceMethodology",
      "type": "object"
    },
    "SourcePolicy": {
      "additionalProperties": false,
      "properties": {
        "approval_required": {
          "$ref": "#/$defs/Requirement"
        },
        "approval_status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "attribution_required": {
          "$ref": "#/$defs/Requirement"
        },
        "attribution_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Text"
        },
        "commercial_use_allowed": {
          "$ref": "#/$defs/Permission"
        },
        "derived_metrics_allowed": {
          "$ref": "#/$defs/Permission"
        },
        "historical_storage_allowed": {
          "$ref": "#/$defs/Permission"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "raw_storage_allowed": {
          "$ref": "#/$defs/Permission"
        },
        "redistribution_allowed": {
          "$ref": "#/$defs/Permission"
        },
        "references": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "retention_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Days"
        },
        "reviewed_at": {
          "format": "date",
          "title": "Reviewed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "raw_storage_allowed",
        "historical_storage_allowed",
        "derived_metrics_allowed",
        "commercial_use_allowed",
        "redistribution_allowed",
        "attribution_required",
        "approval_required",
        "approval_status",
        "reviewed_at",
        "references"
      ],
      "title": "SourcePolicy",
      "type": "object"
    },
    "TermDefinition": {
      "additionalProperties": false,
      "properties": {
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "name",
        "formula",
        "rationale"
      ],
      "title": "TermDefinition",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "$ref": "#/$defs/ConfidenceMethodology"
    },
    "explanations": {
      "title": "Explanations",
      "type": "string"
    },
    "features": {
      "$ref": "#/$defs/FeatureMethodology"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_note": {
      "title": "Scope Note",
      "type": "string"
    },
    "score": {
      "$ref": "#/$defs/ScoreMethodology"
    },
    "score_version": {
      "title": "Score Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceMethodology"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "score_version",
    "scope_note",
    "score",
    "confidence",
    "features",
    "explanations",
    "sources",
    "limitations"
  ],
  "title": "MethodologyArtifact",
  "type": "object"
}
